{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "Library",
            "request": "launch",
            "mainClass": "App",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "vmArgs": "--enable-native-access=ALL-UNNAMED -Dfile.encoding=UTF-8"
        }
    ]
}
